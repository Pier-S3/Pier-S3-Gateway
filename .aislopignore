# Paths aislop should not scan (gitignore-style; merged with the built-in
# node_modules/.git/dist/build/coverage excludes).

# Generated Vite production bundle, committed only so `go build` can embed it
# via go:embed without a Node toolchain. It is minified build output - the
# analogue of dist/ - and is regenerated by `make frontend`. Linting it produces
# only minifier/React/antd noise (deep nesting, "empty catch", innerHTML), never
# actionable source findings.
internal/webui/static
