S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=s3-proxy
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_JWKS_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/certs
# Explicit OAuth2 redirect_uri for the server-side login flow. Allowlist the
# exact value at the IdP. Leave empty to let the SPA (oidc-client-ts) supply it.
OIDC_REDIRECT_URI=https://s3-ui.example.com/api/v1/auth/callback
LISTEN_S3_ADDR=:8080
LISTEN_UI_ADDR=:8081
# Probe-only listener (/_health, /_ready) - never expose it publicly.
LISTEN_HEALTH_ADDR=:8082
LOG_LEVEL=info
